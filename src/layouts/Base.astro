---
import { url } from '../lib/url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import Curtain from '../components/Curtain.astro';
import { site } from '../data/site';
import ogImage from '../assets/photos/hnr25-group.jpg';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: Community runs in Liloan, Cebu`;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/favicon.png')} />
    <meta name="theme-color" content="#0a0a09" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduced');
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SportsOrganization',
        name: site.name,
        sport: 'Running',
        url: Astro.site?.toString(),
        telephone: '+63 960 598 4835',
        founder: site.founder,
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Purok Ube, Catarman',
          addressLocality: 'Liloan',
          addressRegion: 'Cebu',
          postalCode: '6002',
          addressCountry: 'PH',
        },
        sameAs: [site.facebook],
      })}
    />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Preloader />
    <Curtain />
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="grunge" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/transitions';
      import { init, destroy } from '../scripts/motion';
      // The swap replaces <html> attributes, so restore the JS flags before the new page paints.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js', 'no-intro');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduced');
      });
      document.addEventListener('astro:page-load', init);
      document.addEventListener('astro:before-swap', destroy);
    </script>
  </body>
</html>

<style is:global>
  /* Starting states for reveals; only applied when JS runs and motion is allowed */
  html.js:not(.reduced) [data-split] .split-line > span {
    transform: translateY(110%);
  }
  html.js:not(.reduced) [data-reveal-media] {
    clip-path: inset(100% 0% 0% 0%);
  }
  html.js:not(.reduced) [data-fade],
  html.js:not(.reduced) [data-hero-fade] {
    opacity: 0;
    transform: translateY(30px);
  }
  html.js:not(.reduced) [data-words] .w {
    opacity: 0.14;
  }
  .skip {
    position: fixed;
    left: 16px;
    top: -60px;
    z-index: 200;
    background: var(--orange);
    color: #000;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 700;
  }
  .skip:focus {
    top: 16px;
  }
</style>
