---
import { currentEvent, nextUp } from '../data/current-event';
interface Props {
  label?: string;
  class?: string;
  // The run this button signs up for. Left out, it's whichever run is open: the current run,
  // or the next one once the current run's registration has closed.
  run?: { registerUrl: string; registrationOpen: boolean };
}
const { class: cls } = Astro.props;
const nextIsOpen = !currentEvent.registrationOpen && nextUp.registrationOpen;
const run = Astro.props.run ?? (nextIsOpen ? nextUp : currentEvent);
// A general button that signs up for the next run says so, so nobody takes it for the current one
const label = !Astro.props.run && nextIsOpen ? `Register · ${nextUp.shortName}` : (Astro.props.label ?? 'Register now');
---

{
  run.registrationOpen ? (
    <a class:list={['btn btn--cta', cls]} href={run.registerUrl} target="_blank" rel="noopener" data-magnetic>
      {label} <span class="arrow" aria-hidden="true">→</span>
    </a>
  ) : (
    <span class:list={['btn btn--disabled', cls]}>Registration closed</span>
  )
}
