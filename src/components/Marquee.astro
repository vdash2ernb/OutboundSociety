---
interface Props {
  items: string[];
  variant?: 'solid' | 'outline';
}
const { items, variant = 'solid' } = Astro.props;
const run = items.flatMap((t) => [t]);
---

<div class:list={['marquee', variant === 'outline' && 'marquee--outline']} aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <span>
          {run.map((t) => (
            <>
              {t} <i>✦</i>
            </>
          ))}
        </span>
      ))
    }
  </div>
</div>
