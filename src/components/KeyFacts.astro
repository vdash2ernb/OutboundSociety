---
// Row of big key facts under a hero (date, venue, entry...). Two per row on phones.
interface Props {
  items: { label: string; value: string; href?: string; note?: string }[];
  id?: string;
}
const { items, id } = Astro.props;
---

<section class="wrap keyfacts" id={id} style={`--n: ${items.length}`}>
  {
    items.map((f, i) => (
      <div data-fade={i ? (i * 0.05).toFixed(2) : ''}>
        <span>{f.label}</span>
        <strong>
          {f.href ? (
            <a class="link" href={f.href} target="_blank" rel="noopener">
              {f.value}
            </a>
          ) : (
            f.value
          )}
        </strong>
        {f.note && <em>{f.note}</em>}
      </div>
    ))
  }
</section>

<style>
  .keyfacts {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    border-block: 1px solid var(--line);
  }
  .keyfacts > div {
    padding: 28px 20px 28px 0;
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .keyfacts > div + div {
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }
  .keyfacts span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .keyfacts strong {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(26px, 2.6vw, 42px);
    line-height: 1;
  }
  .keyfacts em {
    font-style: normal;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .keyfacts {
      grid-template-columns: 1fr 1fr;
    }
    .keyfacts > div + div:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .keyfacts > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    /* An odd last fact takes the full row */
    .keyfacts > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>
