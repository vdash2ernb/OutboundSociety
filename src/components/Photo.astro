---
// Renders a photo from src/assets/photos by file name, as responsive AVIF/WebP.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  parallax?: boolean;
}

const { name, alt, sizes = '(max-width: 800px) 100vw, 50vw', class: cls, loading = 'lazy', parallax = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const entry = images[`../assets/photos/${name}.jpg`];
if (!entry) throw new Error(`Photo not found: ${name}`);
---

<div class:list={['media', cls]} data-reveal-media>
  <Picture
    src={entry.default}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1800]}
    sizes={sizes}
    loading={loading}
    decoding="async"
    data-parallax={parallax ? '' : undefined}
  />
</div>
