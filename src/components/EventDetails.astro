---
// Full details of the current run: poster, schedule, distances, what's included, candy stations.
import Photo from './Photo.astro';
import RegisterButton from './RegisterButton.astro';
import { currentEvent as ev } from '../data/current-event';
---

<section class="section wrap details">
  <div class="details__poster">
    <Photo name={ev.poster} alt={`${ev.name} poster`} sizes="(max-width: 900px) 100vw, 40vw" />
  </div>
  <div class="details__body">
    <div class="block" data-fade>
      <h3>Race night</h3>
      <ol class="schedule">
        {ev.schedule.map((s) => <li><span class="accent">{s.time}</span>{s.label}</li>)}
      </ol>
    </div>
    <div class="block" data-fade>
      <h3>Pick your distance</h3>
      <div class="cats">
        {ev.categories.map((c) => <div class="cat"><strong class="display">{c.name}</strong><p class="muted">{c.detail}</p></div>)}
      </div>
    </div>
    <div class="block" data-fade>
      <h3>Your {ev.fee} gets you</h3>
      <ul class="ticks">
        {ev.included.map((i) => <li>{i}</li>)}
      </ul>
      <p class="muted">{ev.notes}</p>
    </div>
    <div class="block" data-fade>
      <h3>Candy stations</h3>
      <p class="muted">The kids' route stops at local businesses handing out treats:</p>
      <p class="chips">{ev.candyStations.map((c) => <span>{c}</span>)}</p>
    </div>
    <div class="details__actions" data-fade>
      <RegisterButton label="Secure your slot" />
      <slot />
    </div>
  </div>
</section>

<style>
  .details {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(32px, 6vw, 110px);
    align-items: start;
  }
  .details__poster {
    position: sticky;
    top: 110px;
  }
  .details__body {
    display: grid;
    gap: 56px;
  }
  .details__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    display: grid;
    gap: 18px;
  }
  .schedule {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .schedule li {
    display: flex;
    gap: 20px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }
  .schedule .accent {
    min-width: 88px;
    font-weight: 800;
  }
  .cats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .cat {
    border: 1px solid var(--line);
    padding: 22px;
  }
  .cat strong {
    font-size: clamp(32px, 3vw, 48px);
    display: block;
    line-height: 1;
  }
  .cat p {
    margin: 10px 0 0;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .ticks li {
    display: flex;
    gap: 12px;
    font-weight: 600;
  }
  .ticks li::before {
    content: '✦';
    color: var(--orange);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .chips span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .details {
      grid-template-columns: 1fr;
    }
    .details__poster {
      position: static;
    }
    .cats {
      grid-template-columns: 1fr;
    }
  }
</style>
