---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SplitHeading from '../components/SplitHeading.astro';
import Marquee from '../components/Marquee.astro';
import RegisterButton from '../components/RegisterButton.astro';
import KeyFacts from '../components/KeyFacts.astro';
import EventDetails from '../components/EventDetails.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/faqs';
import { url } from '../lib/url';
import { currentEvent as ev, nextUp } from '../data/current-event';
import { pastEvents } from '../data/past-events';
import { site } from '../data/site';
import { currentEventSchema, nextUpSchema, pastEventSchemas, faqSchema, breadcrumbs } from '../lib/schema';
import { photoUrl } from '../lib/photo-url';

const abs = (p: string) => new URL(p, Astro.site).toString();
const eventImages = await Promise.all([ev.poster, ev.heroPhoto].map((n) => photoUrl(n, Astro.site)));
const nextUpImage = await photoUrl(nextUp.poster, Astro.site);
const pastImages = Object.fromEntries(
  await Promise.all(pastEvents.map(async (e) => [e.cover, await photoUrl(e.cover, Astro.site)] as const))
);
---

<Base
  title={`${ev.name} · Liloan Fun Runs | ${site.name}`}
  description={`${ev.name} is on ${ev.dateLabel} at ${ev.venue}, ${ev.address}. ${ev.fee} includes a finisher's medal and post-run meal. Kids 3 km and adults 5 km. Register online now.`}
  image={ev.featurePhoto}
  imageAlt={`${ev.name}, a community night run in Liloan, Cebu`}
  schema={[
    currentEventSchema(abs, eventImages),
    nextUpSchema(abs, nextUpImage),
    ...pastEventSchemas(abs, (n) => pastImages[n]),
    faqSchema(faqs),
    breadcrumbs(abs, [{ name: 'Events', path: '/events/' }]),
  ]}
>
  <!-- HEADER -->
  <section class="ehero">
    <div class="ehero__bg">
      <Photo name={ev.heroPhoto} alt="" sizes="100vw" loading="eager" parallax />
    </div>
    <div class="wrap ehero__content">
      <span class="eyebrow">Now open · {ev.dateLabel}</span>
      <SplitHeading as="h1" lines={ev.headingLines} accentLast />
      <p class="lede">{ev.tagline} Get your crew ready for a night of running, prizes, surprises and a little bit of fright.</p>
      <div class="ehero__actions">
        <RegisterButton label={`Register · ${ev.fee}`} />
        <a href="#details" class="btn btn--ghost">See details ↓</a>
      </div>
    </div>
  </section>

  <!-- KEY FACTS -->
  <KeyFacts
    id="details"
    items={[
      { label: 'Date', value: ev.dateLabel },
      { label: 'Venue', value: ev.venue, href: ev.mapUrl, note: ev.address },
      { label: 'Entry', value: ev.fee, note: 'Medal + post-run meal' },
      { label: 'Register by', value: ev.registrationCloses },
    ]}
  />

  <!-- DETAILS -->
  <EventDetails>
    <a href={url(`/events/${ev.slug}/`)} class="btn btn--ghost">Run page <span class="arrow" aria-hidden="true">→</span></a>
  </EventDetails>

  <Marquee items={['Thank you to our sponsors', ...ev.sponsors]} />

  <!-- FAQ + DECLARATION -->
  <Faq />

  <!-- COMING UP -->
  <section class="section upnext">
    <div class="wrap upnext__grid">
      <div>
        <span class="eyebrow">Coming up</span>
        <SplitHeading lines={['Pit Señor', 'Fiesta Run']} accentLast />
        <p class="upnext__date display" data-fade>{nextUp.dateLabel}</p>
        <p class="lede" data-fade>{nextUp.blurb}</p>
        <p class="muted" data-fade>{nextUp.place} · Registration details coming soon on Facebook.</p>
        <a class="btn btn--ghost" href={nextUp.link} target="_blank" rel="noopener" data-fade>Get notified on Facebook ↗</a>
      </div>
      <Photo name={nextUp.poster} alt="Pit Señor Fiesta Run poster" sizes="(max-width: 900px) 100vw, 40vw" />
    </div>
  </section>

  <!-- ARCHIVE -->
  <section class="section wrap archive">
    <span class="eyebrow">Archive</span>
    <SplitHeading lines={["Runs we've", 'already made.']} />
    {
      pastEvents.map((e, i) => (
        <article class="past" id={e.slug}>
          <header class="past__head">
            <h3><a href={url(`/events/${e.slug}/`)}>{e.name}</a></h3>
            <span class="past__when">{e.when}</span>
          </header>
          <div class="past__body">
            <div class="past__text" data-fade>
              <p class="lede">{e.summary}</p>
              <p class="muted">{e.where}</p>
              <a class="link past__more" href={url(`/events/${e.slug}/`)}>The full story and photos →</a>
            </div>
            <div class="photo-grid past__photos">
              {e.photos.map((p) => (
                <Photo name={p} alt={`${e.name}, ${e.when}`} sizes="(max-width: 600px) 50vw, (max-width: 900px) 33vw, 20vw" />
              ))}
            </div>
          </div>
        </article>
      ))
    }
    <p class="archive__more" data-fade>
      More photos and race-day videos live on our <a class="link" href={site.facebook} target="_blank" rel="noopener">Facebook page</a>.
    </p>
  </section>
</Base>

<style>
  .ehero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .ehero__bg {
    position: absolute;
    inset: 0;
  }
  .ehero__bg :global(.media) {
    height: 100%;
  }
  .ehero__bg :global(img) {
    object-position: 50% 85%;
  }
  .ehero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 9, 0.6), rgba(10, 10, 9, 0.35) 40%, rgba(10, 10, 9, 0.97));
  }
  .ehero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    gap: 24px;
    padding-top: 140px;
    padding-bottom: clamp(48px, 7vw, 100px);
  }
  .ehero__content :global(h1) {
    font-size: clamp(64px, min(14vw, 22vh), 260px);
    line-height: 0.84;
  }
  /* "2026" keeps its orange outline, with a subtle 15% fill */
  .ehero__content :global(h1 .outline) {
    color: rgba(255, 90, 26, 0.15);
  }
  .ehero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .upnext {
    background: var(--bg-2);
  }
  .upnext__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 100px);
    align-items: center;
  }
  .upnext__grid > div:first-child {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .upnext__date {
    font-size: clamp(32px, 3.4vw, 56px);
    margin: 0;
  }
  @media (max-width: 900px) {
    .upnext__grid {
      grid-template-columns: 1fr;
    }
  }

  .archive > :global(h2) {
    margin: 20px 0 clamp(40px, 6vw, 90px);
  }
  .past {
    border-top: 1px solid var(--line);
    padding-block: clamp(32px, 4vw, 56px);
    scroll-margin-top: 100px;
  }
  .past__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 28px;
  }
  .past__head h3 {
    font-size: clamp(40px, 5.5vw, 96px);
  }
  .past__when {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .past__body {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(24px, 4vw, 64px);
  }
  .past__head h3 a {
    text-decoration: none;
    transition: color 0.3s;
  }
  .past__head h3 a:hover {
    color: var(--orange);
  }
  .past__more {
    font-weight: 700;
  }
  .past__text p {
    margin: 0 0 12px;
  }
  .archive__more {
    border-top: 1px solid var(--line);
    padding-top: 32px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .past__head {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .past__body {
      grid-template-columns: 1fr;
    }
  }
</style>
