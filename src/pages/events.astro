---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SplitHeading from '../components/SplitHeading.astro';
import Marquee from '../components/Marquee.astro';
import RegisterButton from '../components/RegisterButton.astro';
import { currentEvent as ev, nextUp } from '../data/current-event';
import { pastEvents } from '../data/past-events';
import { site } from '../data/site';

const faqs = [
  {
    q: 'Do I need to be a fast runner?',
    a: 'Not at all. There is no cut-off pressure. We celebrate every finisher, whether you run, jog or walk.',
  },
  {
    q: 'Do I need a costume?',
    a: 'No. Costumes are optional (there are prizes if you do dress up). Comfortable running attire is perfect.',
  },
  {
    q: 'How do I register?',
    a: `Fill in the official Google Form using the Register button, then follow the payment instructions on the form. Questions? Message us on Facebook: it's the fastest way to reach us.`,
  },
  {
    q: 'Where do runs usually start?',
    a: 'It depends on the route. Recent runs started at Bakeria Box (Bajac), BIG APPLE by the bay, Landing Market in Catarman, and Liloan Bridge. Exact assembly details are posted on Facebook before race day.',
  },
  {
    q: 'Is it safe for kids?',
    a: 'Kids have their own shorter route, gun start and marshals. Parents are welcome to run alongside their little ones.',
  },
  {
    q: 'Where does my registration fee go?',
    a: 'Outbound Society is a non-profit. Every peso goes back into organizing the next run: medals, meals, marshals and hydration.',
  },
];
---

<Base title="Events" description={`${ev.name}: ${ev.dateLabel} at ${ev.venue}, ${ev.address}. ${ev.fee} with medal and post-run meal. Register now.`}>
  <!-- HEADER -->
  <section class="ehero">
    <div class="ehero__bg">
      <Photo name={ev.heroPhoto} alt="" sizes="100vw" loading="eager" parallax />
    </div>
    <div class="wrap ehero__content">
      <span class="eyebrow">Now open · {ev.dateLabel}</span>
      <SplitHeading as="h1" lines={ev.headingLines} accentLast />
      <p class="lede">{ev.tagline} Get your crew ready for a night of running, prizes, surprises and a little bit of fright.</p>
      <div class="ehero__actions">
        <RegisterButton label={`Register · ${ev.fee}`} />
        <a href="#details" class="btn btn--ghost">See details ↓</a>
      </div>
    </div>
  </section>

  <!-- KEY FACTS -->
  <section class="wrap keyfacts" id="details">
    <div data-fade><span>Date</span><strong>{ev.dateLabel}</strong></div>
    <div data-fade="0.05"><span>Venue</span><strong><a class="link" href={ev.mapUrl} target="_blank" rel="noopener">{ev.venue}</a></strong><em>{ev.address}</em></div>
    <div data-fade="0.1"><span>Entry</span><strong>{ev.fee}</strong><em>Medal + post-run meal</em></div>
    <div data-fade="0.15"><span>Register by</span><strong>{ev.registrationCloses}</strong></div>
  </section>

  <!-- DETAILS -->
  <section class="section wrap details">
    <div class="details__poster">
      <Photo name={ev.poster} alt={`${ev.name} poster`} sizes="(max-width: 900px) 100vw, 40vw" />
    </div>
    <div class="details__body">
      <div class="block" data-fade>
        <h3>Race night</h3>
        <ol class="schedule">
          {ev.schedule.map((s) => <li><span class="accent">{s.time}</span>{s.label}</li>)}
        </ol>
      </div>
      <div class="block" data-fade>
        <h3>Pick your distance</h3>
        <div class="cats">
          {ev.categories.map((c) => <div class="cat"><strong class="display">{c.name}</strong><p class="muted">{c.detail}</p></div>)}
        </div>
      </div>
      <div class="block" data-fade>
        <h3>Your {ev.fee} gets you</h3>
        <ul class="ticks">
          {ev.included.map((i) => <li>{i}</li>)}
        </ul>
        <p class="muted">{ev.notes}</p>
      </div>
      <div class="block" data-fade>
        <h3>Candy stations</h3>
        <p class="muted">The kids' route stops at local businesses handing out treats:</p>
        <p class="chips">{ev.candyStations.map((c) => <span>{c}</span>)}</p>
      </div>
      <div data-fade>
        <RegisterButton label="Secure your slot" />
      </div>
    </div>
  </section>

  <Marquee items={['Thank you to our sponsors', ...ev.sponsors]} />

  <!-- FAQ + DECLARATION -->
  <section class="section wrap faq">
    <div>
      <span class="eyebrow">Good to know</span>
      <SplitHeading lines={['Questions,', 'answered.']} />
    </div>
    <div class="faq__list">
      {
        faqs.map((f) => (
          <details class="faq__item">
            <summary>
              {f.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <div class="declaration">
        <strong>Participant declaration</strong>
        <p class="muted">
          By registering, you acknowledge that community running events involve physical activity, confirm that you are medically fit to take part, and agree to follow the safety guidelines set by Outbound Society race marshals along the route.
        </p>
      </div>
    </div>
  </section>

  <!-- COMING UP -->
  <section class="section upnext">
    <div class="wrap upnext__grid">
      <div>
        <span class="eyebrow">Coming up</span>
        <SplitHeading lines={['Pit Señor', 'Fiesta Run']} accentLast />
        <p class="upnext__date display" data-fade>{nextUp.dateLabel}</p>
        <p class="lede" data-fade>{nextUp.blurb}</p>
        <p class="muted" data-fade>{nextUp.place} · Registration details coming soon on Facebook.</p>
        <a class="btn btn--ghost" href={nextUp.link} target="_blank" rel="noopener" data-fade>Get notified on Facebook ↗</a>
      </div>
      <Photo name={nextUp.poster} alt="Pit Señor Fiesta Run poster" sizes="(max-width: 900px) 100vw, 40vw" />
    </div>
  </section>

  <!-- ARCHIVE -->
  <section class="section wrap archive">
    <span class="eyebrow">Archive</span>
    <SplitHeading lines={["Runs we've", 'already made.']} />
    {
      pastEvents.map((e, i) => (
        <article class="past" id={e.slug}>
          <header class="past__head">
            <h3>{e.name}</h3>
            <span class="past__when">{e.when}</span>
          </header>
          <div class="past__body">
            <div class="past__text" data-fade>
              <p class="lede">{e.summary}</p>
              <p class="muted">{e.where}</p>
            </div>
            <div class:list={['past__photos', `n${Math.min(e.photos.length, 8)}`]}>
              {e.photos.map((p) => (
                <Photo name={p} alt={`${e.name}, ${e.when}`} sizes="(max-width: 900px) 50vw, 20vw" />
              ))}
            </div>
          </div>
        </article>
      ))
    }
    <p class="archive__more" data-fade>
      More photos and race-day videos live on our <a class="link" href={site.facebook} target="_blank" rel="noopener">Facebook page</a>.
    </p>
  </section>
</Base>

<style>
  .ehero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .ehero__bg {
    position: absolute;
    inset: 0;
  }
  .ehero__bg :global(.media) {
    height: 100%;
  }
  .ehero__bg :global(img) {
    object-position: 50% 85%;
  }
  .ehero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 9, 0.6), rgba(10, 10, 9, 0.35) 40%, rgba(10, 10, 9, 0.97));
  }
  .ehero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    gap: 24px;
    padding-top: 140px;
    padding-bottom: clamp(48px, 7vw, 100px);
  }
  .ehero__content :global(h1) {
    font-size: clamp(64px, min(14vw, 22vh), 260px);
    line-height: 0.84;
  }
  .ehero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .keyfacts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
  }
  .keyfacts > div {
    padding: 28px 20px 28px 0;
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .keyfacts > div + div {
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }
  .keyfacts span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .keyfacts strong {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(26px, 2.6vw, 42px);
    line-height: 1;
  }
  .keyfacts em {
    font-style: normal;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .keyfacts {
      grid-template-columns: 1fr 1fr;
    }
    .keyfacts > div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .keyfacts > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  .details {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(32px, 6vw, 110px);
    align-items: start;
  }
  .details__poster {
    position: sticky;
    top: 110px;
  }
  .details__body {
    display: grid;
    gap: 56px;
  }
  .block {
    display: grid;
    gap: 18px;
  }
  .schedule {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .schedule li {
    display: flex;
    gap: 20px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }
  .schedule .accent {
    min-width: 88px;
    font-weight: 800;
  }
  .cats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .cat {
    border: 1px solid var(--line);
    padding: 22px;
  }
  .cat strong {
    font-size: clamp(32px, 3vw, 48px);
    display: block;
    line-height: 1;
  }
  .cat p {
    margin: 10px 0 0;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .ticks li {
    display: flex;
    gap: 12px;
    font-weight: 600;
  }
  .ticks li::before {
    content: '✦';
    color: var(--orange);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .chips span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .details {
      grid-template-columns: 1fr;
    }
    .details__poster {
      position: static;
    }
    .cats {
      grid-template-columns: 1fr;
    }
  }

  .faq {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 100px);
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 22px;
    font-weight: 700;
    font-size: clamp(18px, 1.4vw, 22px);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary span {
    color: var(--orange);
    font-size: 26px;
    line-height: 1;
    transition: transform 0.4s var(--ease);
  }
  .faq__item[open] summary span {
    transform: rotate(45deg);
  }
  .faq__item p {
    margin: 0 0 24px;
    color: var(--muted);
    max-width: 60ch;
  }
  .declaration {
    margin-top: 36px;
    padding: 24px;
    border-left: 3px solid var(--orange);
    background: var(--bg-2);
  }
  .declaration p {
    margin: 8px 0 0;
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }

  .upnext {
    background: var(--bg-2);
  }
  .upnext__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 100px);
    align-items: center;
  }
  .upnext__grid > div:first-child {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .upnext__date {
    font-size: clamp(32px, 3.4vw, 56px);
    margin: 0;
  }
  @media (max-width: 900px) {
    .upnext__grid {
      grid-template-columns: 1fr;
    }
  }

  .archive > :global(h2) {
    margin: 20px 0 clamp(40px, 6vw, 90px);
  }
  .past {
    border-top: 1px solid var(--line);
    padding-block: clamp(32px, 4vw, 56px);
    scroll-margin-top: 100px;
  }
  .past__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 28px;
  }
  .past__head h3 {
    font-size: clamp(40px, 5.5vw, 96px);
  }
  .past__when {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .past__body {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(24px, 4vw, 64px);
  }
  .past__text p {
    margin: 0 0 12px;
  }
  .past__photos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .past__photos :global(.media) {
    aspect-ratio: 1;
  }
  .past__photos.n3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .archive__more {
    border-top: 1px solid var(--line);
    padding-top: 32px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .past__head {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .past__body {
      grid-template-columns: 1fr;
    }
    .past__photos {
      grid-template-columns: repeat(2, 1fr);
    }
    .past__photos.n3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
